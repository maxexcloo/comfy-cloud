{
  "autostart_policy": true,
  "display_name": "Comfy Control",
  "replicas": 1,
  "restart_policy": "always",
  "container": {
    "command": ["comfy-control", "serverless"],
    "image_caching": true,
    "priority": "low",
    "environment_variables": {},
    "resources": {
      "cpu": 4,
      "memory": 16384,
      "storage_amount": 53687091200,
      "gpu_classes": ["CHANGE_ME"]
    }
  },
  "liveness_probe": {
    "failure_threshold": 3,
    "initial_delay_seconds": 0,
    "period_seconds": 30,
    "success_threshold": 1,
    "timeout_seconds": 5,
    "http": {
      "path": "/health/live",
      "port": 8000
    }
  },
  "networking": {
    "auth": false,
    "port": 8000,
    "protocol": "http"
  },
  "readiness_probe": {
    "failure_threshold": 3,
    "initial_delay_seconds": 0,
    "period_seconds": 5,
    "success_threshold": 1,
    "timeout_seconds": 3,
    "http": {
      "path": "/health/ready",
      "port": 8000
    }
  },
  "startup_probe": {
    "failure_threshold": 180,
    "initial_delay_seconds": 0,
    "period_seconds": 5,
    "success_threshold": 1,
    "timeout_seconds": 3,
    "http": {
      "path": "/health/live",
      "port": 8000
    }
  }
}
