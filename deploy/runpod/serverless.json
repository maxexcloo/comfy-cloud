{
  "containerDiskInGb": 30,
  "dockerArgs": "comfy-control serverless",
  "endpointType": "load-balancer",
  "imageName": "ghcr.io/maxexcloo/comfy-control:worker",
  "ports": "8000/http",
  "env": [
    { "key": "API_KEY", "value": "CHANGE_ME" },
    { "key": "JOBS_DIR", "value": "/runpod-volume/jobs" },
    { "key": "MAXIMUM_PENDING_GENERATIONS", "value": "8" },
    { "key": "MAXIMUM_REQUEST_BYTES", "value": "104857600" },
    { "key": "MODELS_DIR", "value": "/runpod-volume/models" },
    { "key": "PORT", "value": "8000" },
    { "key": "PORT_HEALTH", "value": "8000" }
  ]
}
