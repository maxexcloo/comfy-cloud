{
  "containerDiskInGb": 30,
  "dockerArgs": "",
  "imageName": "ghcr.io/OWNER/comfy-cloud:TAG",
  "name": "comfy-cloud",
  "ports": "8000/http",
  "volumeInGb": 100,
  "volumeMountPath": "/opt/ComfyUI/models",
  "env": [
    { "key": "API_KEY", "value": "CHANGE_ME" },
    { "key": "COMFY_UI_PASSWORD", "value": "CHANGE_ME" },
    { "key": "COMFY_UI_USERNAME", "value": "comfy" },
    { "key": "MODE", "value": "pod" },
    { "key": "MODEL_PROFILES", "value": "flux-2-klein-4b" }
  ]
}
