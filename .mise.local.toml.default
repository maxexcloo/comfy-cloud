[env]
# Gateway
API_KEY = "REPLACE_ME"
COMFY_UI_PASSWORD = "REPLACE_ME"
COMFY_UI_USERNAME = "REPLACE_ME"

# Model downloads (gated repos require HF_TOKEN)
HF_TOKEN = "REPLACE_ME"
CIVITAI_TOKEN = "REPLACE_ME"

# S3-compatible output storage (optional)
S3_ENDPOINT_URL = "REPLACE_ME"
S3_BUCKET = "REPLACE_ME"
S3_ACCESS_KEY_ID = "REPLACE_ME"
S3_SECRET_ACCESS_KEY = "REPLACE_ME"
S3_REGION = "us-east-1"
S3_PREFIX = "outputs"
S3_PUBLIC_BASE_URL = ""
S3_URL_EXPIRES = "3600"

# Modal
MODAL_TOKEN_ID = "REPLACE_ME"
MODAL_TOKEN_SECRET = "REPLACE_ME"
COMFY_CLOUD_IMAGE = "ghcr.io/maxexcloo/comfy-cloud:latest"
MODAL_GPU = "L40S"
MODAL_SECRET = "comfy-cloud"
MODAL_MODEL_VOLUME = "comfy-cloud-models"

# RunPod
RUNPOD_API_KEY = "REPLACE_ME"

# Vast.ai
VAST_API_KEY = "REPLACE_ME"
VAST_OFFER_ID = "REPLACE_ME"
