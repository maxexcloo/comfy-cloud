[env]
# Image
IMAGE_NAME = "ghcr.io/maxexcloo/inference-control:latest"

# Gateway
API_KEY = "REPLACE_ME"
CATALOGUE_DIR = ""
COMFY_UI_PASSWORD = "REPLACE_ME"
COMFY_UI_USERNAME = "REPLACE_ME"
JOBS_DIR = ""
MAXIMUM_PENDING_GENERATIONS = "8"
MAXIMUM_REQUEST_BYTES = "104857600"
MODEL_PROFILES = ""
PUBLIC_BASE_URL = ""

# Model downloads (gated repos require HF_TOKEN)
CIVITAI_TOKEN = ""
HF_TOKEN = ""

# S3-compatible output storage (optional)
S3_ACCESS_KEY_ID = "REPLACE_ME"
S3_BUCKET = "REPLACE_ME"
S3_ENDPOINT_URL = "REPLACE_ME"
S3_PREFIX = "outputs"
S3_PUBLIC_BASE_URL = ""
S3_REGION = "us-east-1"
S3_SECRET_ACCESS_KEY = "REPLACE_ME"
S3_URL_EXPIRES = "3600"

# Modal
COMFY_CONTROL_IMAGE = "ghcr.io/maxexcloo/inference-control:latest"
MODAL_GPU = "L40S"
MODAL_MIN_CONTAINERS = "0"
MODAL_MODEL_VOLUME = "comfy-control-models"
MODAL_SCALEDOWN_WINDOW = "60"
MODAL_SECRET = "comfy-control"
MODAL_TOKEN_ID = "REPLACE_ME"
MODAL_TOKEN_SECRET = "REPLACE_ME"

# RunPod
RUNPOD_API_KEY = "REPLACE_ME"
RUNPOD_CONTAINER_DISK_GB = "30"
RUNPOD_GPU_TYPE = "NVIDIA GeForce RTX 4090"
RUNPOD_NETWORK_VOLUME_ID = ""
RUNPOD_POD_ID = "REPLACE_ME"
RUNPOD_VOLUME_GB = "100"

# SaladCloud
SALAD_API_KEY = "REPLACE_ME"
SALAD_CONTAINER_GROUP = "comfy-control"
SALAD_GPU_CLASSES = '["REPLACE_ME"]'
SALAD_IMAGE_NAME = "ghcr.io/maxexcloo/inference-control:latest"
SALAD_ORGANISATION = "REPLACE_ME"
SALAD_PRIORITY = "low"
SALAD_PROJECT = "REPLACE_ME"
SALAD_REPLICAS = "1"

# Vast.ai
VAST_API_KEY = "REPLACE_ME"
VAST_DISK_GB = "100"
VAST_INSTANCE_ID = "REPLACE_ME"
VAST_OFFER_ID = "REPLACE_ME"
