    "inputs": {
      "images": ["12", 0],
      "fps": 24.0,
      "audio": ["13", 0],
      "bit_depth": 8
    }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "video/minimax-h3-i2v",
      "format": "auto",
      "codec": "auto"
    }
  }
