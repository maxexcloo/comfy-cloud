{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enablePreCommit"],
  "packageRules": [
    {
      "description": "Group minor updates",
      "groupName": "Minor updates",
      "matchUpdateTypes": ["minor"]
    },
    {
      "description": "Group patch and pin updates",
      "groupName": "Patch and pin updates",
      "matchUpdateTypes": ["patch", "pin"]
    },
    {
      "description": "Use Bifrost HTTP container tags",
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["maximhq/bifrost"]
    }
  ]
}
