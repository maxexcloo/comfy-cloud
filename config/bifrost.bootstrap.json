{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": true
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "vk-personal",
        "name": "personal",
        "value": "env.BIFROST_API_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "cliproxy",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "comfy-control",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      }
    ]
  },
  "providers": {
    "cliproxy": {
      "keys": [
        {
          "name": "cliproxy",
          "value": "env.CLIPROXY_API_KEY",
          "models": ["*"],
          "weight": 1
        }
      ],
      "network_config": {
        "allow_private_network": true,
        "base_url": "http://cliproxy:8317/v1",
        "default_request_timeout_in_seconds": 1200
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "comfy-control": {
      "keys": [
        {
          "name": "comfy-control",
          "value": "env.COMFY_CONTROL_API_KEY",
          "models": ["*"],
          "weight": 1
        }
      ],
      "network_config": {
        "allow_private_network": true,
        "base_url": "http://comfy-control:8000/v1",
        "default_request_timeout_in_seconds": 1200
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./logs.db"
    }
  }
}
